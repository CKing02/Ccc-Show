{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccc-show",
  "pages_build_output_dir": ".open-next",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
